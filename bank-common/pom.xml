<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.dz</groupId>
    <artifactId>bank</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>bank-common</artifactId>
  <packaging>jar</packaging>
  <name>bank-common</name>
  <description>
    通用基础模块：统一响应体 R 与全局异常、错误码常量、
    Redis 缓存封装（含 Lua 原子扣减）与 Redisson 分布式锁、
    令牌桶四级限流、PII 分级脱敏、DFA/Trie 工具、日志与幂等切面
  </description>

  <dependencies>

    <!-- ========== Web：统一响应体、全局异常处理、Jackson 序列化 ========== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- ========== 参数校验：@Validated / @NotBlank 等 ========== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ========== AOP：日志、幂等、限流、脱敏切面 ========== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- ========== Redis：缓存预热、会话状态、原子扣减（Lua 脚本） ========== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Lettuce 连接池需要 commons-pool2，否则 spring.data.redis.lettuce.pool 配置无效 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-pool2</artifactId>
    </dependency>

    <!-- ========== Redisson：分布式锁、布隆过滤器（缓存穿透）、令牌桶限流 ========== -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-data-35</artifactId>
    </dependency>

    <!-- ========== 工具：DFA 敏感词、DesensitizedUtil 脱敏、Trie 术语归一化 ========== -->
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-all</artifactId>
    </dependency>
    <!-- Guava：RateLimiter 令牌桶（用户级 / IP 级 / 设备级 / 全局级） -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
    </dependency>

    <!-- ========== 对象映射：DTO / VO / Entity 转换 ========== -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- ========== 配置元数据：@ConfigurationProperties 在 IDEA 中有提示 ========== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

  </dependencies>

  <!--
    注意：本模块是库（不可运行），不要加 spring-boot-maven-plugin 的 repackage。
    Lombok 与 spring-boot-starter-test 已在父 pom 统一引入。
  -->

</project>